# Copiá este archivo a .env y completá tus keys reales. Nunca commitees .env.

# --- LLM (resumen, análisis, guiones) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Text-to-speech ---
# Por defecto se usa gTTS (gratis, sin key). Para mejor calidad de voz,
# seteá TTS_PROVIDER=elevenlabs y completá la key.
TTS_PROVIDER=gtts
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Datos de mercado ---
# yfinance no requiere key. Si más adelante migrás a un proveedor pago
# (Polygon.io, Alpha Vantage), agregá la key acá.
MARKET_DATA_PROVIDER=yfinance
POLYGON_API_KEY=

# --- YouTube (YouTube Data API v3) ---
# 1. Crear proyecto en https://console.cloud.google.com/
# 2. Habilitar "YouTube Data API v3"
# 3. Crear credenciales OAuth 2.0 (Desktop app) y descargar el JSON
YOUTUBE_CLIENT_SECRETS_FILE=./secrets/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=./secrets/youtube_token.json

# --- Instagram (Graph API, requiere cuenta Business/Creator + Meta App) ---
# https://developers.facebook.com/docs/instagram-platform/content-publishing
META_APP_ID=
META_APP_SECRET=
IG_BUSINESS_ACCOUNT_ID=
IG_ACCESS_TOKEN=

# --- TikTok (Content Posting API, requiere app aprobada) ---
# https://developers.tiktok.com/doc/content-posting-api-get-started
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
